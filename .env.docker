# ============================================================
# .env.docker - Variables para docker-compose local
# IMPORTANTE: No commitear este archivo con datos reales.
#             Copia de .env.docker.example y personaliza.
# ============================================================

# Base de datos MySQL
DB_HOST=db
BACKEND_PORT=5001
DB_PORT=3306
DB_USER=goodmates_user
DB_PASSWORD=goodmates_root_dev
DB_ROOT_PASSWORD=goodmates_root_dev
DB_NAME=goodmates

# Seguridad
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro_en_produccion

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=

# CORS - URL publica del frontend
FRONTEND_URL=http://localhost

# Para produccion en AWS (se sobreescribe automaticamente por CloudFormation)
# FRONTEND_URL=https://tu-distribucion.cloudfront.net
