# ============================================================
# Dockerfile - Frontend GoodMates (React)
# Multi-stage: build con Node y servir con Nginx
# ============================================================

# ------- Etapa 1: Build React -------
FROM node:20-alpine AS builder
WORKDIR /app

# Copiar manifiestos e instalar dependencias
COPY frontend/package*.json ./
RUN npm ci

# Copiar codigo fuente y construir bundle de produccion
COPY frontend/ ./
RUN npm run build

# ------- Etapa 2: Servidor Nginx para archivos estaticos -------
FROM nginx:1.27-alpine AS runner

# Copiar configuracion personalizada de Nginx
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar el build de React al directorio de Nginx
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
